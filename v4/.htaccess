RewriteEngine On

# 1. Дозволяємо заголовок Authorization
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

# 2. Налаштування роутингу
RewriteBase /api/v4

# Якщо файл існує (наприклад, test_auth.php), відкриваємо його
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Якщо файлу немає, шлемо все на index.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php [QSA,L]

